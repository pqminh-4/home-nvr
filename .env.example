# Mặc định chỉ mở trên loopback; truy cập từ xa an toàn được triển khai ở Phần 7.
NVR_HOST=127.0.0.1
NVR_PORT=3000
NVR_DATA_DIR=.data
NVR_LOG_LEVEL=info
NVR_WEB_ORIGIN=http://127.0.0.1:5173

NVR_SETUP_TOKEN=thay-bang-token-ngau-nhien-32-ky-tu
NVR_SECRET_KEY=thay-bang-bi-mat-dai-it-nhat-32-ky-tu

# Có thể trỏ tới binary MediaMTX/FFmpeg riêng; MediaMTX bắt buộc cho live, FFmpeg chỉ cần khi phải chuyển codec.
NVR_MEDIAMTX_BIN=mediamtx
NVR_FFMPEG_BIN=ffmpeg

# Remote qua Cloudflare Tunnel; dịch vụ vẫn chỉ lắng nghe 127.0.0.1.
# Tạo hostname Public trong Cloudflare rồi trỏ service về http://127.0.0.1:3000.
NVR_PUBLIC_ORIGIN=
NVR_CLOUDFLARED_BIN=cloudflared
NVR_TUNNEL_TOKEN_FILE=
